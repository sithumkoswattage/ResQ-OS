PORT=5000
MONGO_URI=mongodb://localhost:27017/resqos
# Random string, 16+ characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Comma-separated browser origins allowed to call the API (defaults to the Vite dev server)
CORS_ORIGINS=http://localhost:5173
# Set to the number of reverse proxies in front of the API (e.g. 1 behind nginx)
# TRUST_PROXY=1
# OSRM-compatible routing endpoint. The public demo server is for light development only.
# ROUTING_URL=https://router.project-osrm.org
# ROUTING_TIMEOUT_MS=4000
# Seconds-as-milliseconds a unit may go without a location ping before it counts as offline
# UNIT_ONLINE_WINDOW_MS=60000
